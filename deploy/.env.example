# Copy to .env and adjust. This file holds NO secrets: every credential is
# generated by Marineris into $MARINERIS_DATA/secrets (mode 0600).

# Absolute path of the data directory. It is mounted at the SAME path inside
# the Marineris container, so bind mounts in your stacks resolve correctly.
MARINERIS_DATA=/opt/marineris/data

# Group owning /var/run/docker.sock (stat -c %g /var/run/docker.sock).
# install.sh fills it in.
DOCKER_GID=

# Host folders that stacks may bind-mount (comma-separated), in addition to
# each stack's own folder.
MARINERIS_ALLOWED_BIND_ROOTS=/srv,/mnt,/media

# Loopback port of the break-glass / first-run listener.
MARINERIS_LOCAL_PORT=8081

# Images (pin a release tag in production, e.g. :v0.1.0).
MARINERIS_IMAGE=ghcr.io/photonring/marineris:latest
MARINERIS_CADDY_IMAGE=ghcr.io/photonring/marineris-caddy:latest

# Optional: a directory (inside MARINERIS_DATA) with your logo.svg,
# favicon.svg and theme.json.
# MARINERIS_BRANDING_DIR=/opt/marineris/data/branding

MARINERIS_LOG_LEVEL=info
